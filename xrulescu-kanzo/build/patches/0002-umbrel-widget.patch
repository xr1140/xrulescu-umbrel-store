+/// The Umbrel home-screen widget: how many tasks sit in each column.
+#[derive(Serialize)]
+struct Widget {
+    #[serde(rename = "type")]
+    kind: &'static str,
+    refresh: &'static str,
+    link: &'static str,
+    items: Vec<WidgetItem>,
+}
+
+#[derive(Serialize)]
+struct WidgetItem {
+    title: &'static str,
+    text: String,
+}
+
+async fn widget(State(home): Shared) -> Response {
+    with_store(home, move |_, s| {
+        let tasks = s.list_tasks_keeping_done(None, None, None)?.0;
+        let count = |status: &str| tasks.iter().filter(|t| t.status == status).count().to_string();
+        Ok(Widget {
+            kind: "four-stats",
+            refresh: "60s",
+            link: "",
+            items: vec![
+                WidgetItem { title: "Todo", text: count("todo") },
+                WidgetItem { title: "Doing", text: count("doing") },
+                WidgetItem { title: "Review", text: count("review") },
+                WidgetItem { title: "Done", text: count("done") },
+            ],
+        })
+    })
+    .await
+}
+
+/// The per-project widget: the top projects by open work, with their column counts.
+#[derive(Serialize)]
+struct WidgetList {
+    #[serde(rename = "type")]
+    kind: &'static str,
+    refresh: &'static str,
+    link: &'static str,
+    items: Vec<WidgetListItem>,
+    #[serde(rename = "noItemsText")]
+    no_items_text: &'static str,
+}
+
+#[derive(Serialize)]
+struct WidgetListItem {
+    subtext: String,
+    text: String,
+}
+
+async fn widget_projects(State(home): Shared) -> Response {
+    with_store(home, move |_, s| {
+        let projects = s.list_projects()?;
+        let tasks = s.list_tasks_keeping_done(None, None, None)?.0;
+        let mut counts: HashMap<&str, [usize; 3]> = HashMap::new();
+        for task in &tasks {
+            let slot = match task.status.as_str() {
+                "todo" => 0,
+                "doing" => 1,
+                "review" => 2,
+                _ => continue,
+            };
+            counts.entry(task.project.as_str()).or_default()[slot] += 1;
+        }
+        let mut rows: Vec<(&str, usize, usize, usize)> = projects
+            .iter()
+            .map(|p| {
+                let name = if p.name.is_empty() { p.slug.as_str() } else { p.name.as_str() };
+                let [todo, doing, review] = counts.get(p.slug.as_str()).copied().unwrap_or([0; 3]);
+                (name, todo, doing, review)
+            })
+            .collect();
+        rows.sort_by(|a, b| {
+            let a_open = a.1 + a.2 + a.3;
+            let b_open = b.1 + b.2 + b.3;
+            b_open.cmp(&a_open).then_with(|| a.0.cmp(b.0))
+        });
+        let items = rows
+            .into_iter()
+            .take(3)
+            .map(|(name, todo, doing, review)| WidgetListItem {
+                subtext: name.to_string(),
+                text: format!("{todo} todo · {doing} doing · {review} review"),
+            })
+            .collect();
+        Ok(WidgetList {
+            kind: "list",
+            refresh: "60s",
+            link: "",
+            items,
+            no_items_text: "No projects yet",
+        })
+    })
+    .await
+}
+
