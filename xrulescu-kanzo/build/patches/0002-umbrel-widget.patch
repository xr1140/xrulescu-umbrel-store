+/// The Umbrel home-screen widget: how many tasks sit in each column.
+#[derive(Serialize)]
+struct Widget {
+    #[serde(rename = "type")]
+    kind: &'static str,
+    refresh: &'static str,
+    link: &'static str,
+    items: Vec<WidgetItem>,
+}
+
+#[derive(Serialize)]
+struct WidgetItem {
+    title: &'static str,
+    text: String,
+}
+
+async fn widget(State(home): Shared) -> Response {
+    with_store(home, move |_, s| {
+        let tasks = s.list_tasks_keeping_done(None, None, None)?.0;
+        let count = |status: &str| tasks.iter().filter(|t| t.status == status).count().to_string();
+        Ok(Widget {
+            kind: "four-stats",
+            refresh: "60s",
+            link: "",
+            items: vec![
+                WidgetItem { title: "Todo", text: count("todo") },
+                WidgetItem { title: "Doing", text: count("doing") },
+                WidgetItem { title: "Review", text: count("review") },
+                WidgetItem { title: "Done", text: count("done") },
+            ],
+        })
+    })
+    .await
+}
+
+/// The per-project widget: one row per project with its open and done counts.
+#[derive(Serialize)]
+struct WidgetList {
+    #[serde(rename = "type")]
+    kind: &'static str,
+    refresh: &'static str,
+    link: &'static str,
+    items: Vec<WidgetListItem>,
+    #[serde(rename = "noItemsText")]
+    no_items_text: &'static str,
+}
+
+#[derive(Serialize)]
+struct WidgetListItem {
+    subtext: String,
+    text: String,
+}
+
+async fn widget_projects(State(home): Shared) -> Response {
+    with_store(home, move |_, s| {
+        let items = s
+            .list_projects()?
+            .iter()
+            .take(5)
+            .map(|p| {
+                let name = if p.name.is_empty() { p.slug.clone() } else { p.name.clone() };
+                WidgetListItem { subtext: name, text: format!("{} open · {} done", p.open, p.total - p.open) }
+            })
+            .collect();
+        Ok(WidgetList {
+            kind: "list",
+            refresh: "60s",
+            link: "",
+            items,
+            no_items_text: "No projects yet",
+        })
+    })
+    .await
+}
+
